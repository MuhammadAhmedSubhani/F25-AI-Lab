import math

count = 0

def minimax(depth, index, max1, scores, target):
    global count

    if depth == target:
        count += 1
        return scores[index]

    if max1:
        value = float('-inf')

        for i in range(2):
            value = max(
                value,
                minimax(depth + 1, index * 2 + i, False, scores, target)
            )

        return value

    else:
        value = float('inf')

        for i in range(2):
            value = min(
                value,
                minimax(depth + 1, index * 2 + i, True, scores, target)
            )

        return value

def alphabeta(depth, index, max1, scores, target, alpha, beta):
    global count

    if depth == target:
        count += 1
        return scores[index]

    if max1:
        value = float('-inf')

        for i in range(2):
            value = max(
                value,
                alphabeta(depth + 1, index * 2 + i, False,
                          scores, target, alpha, beta)
            )

            alpha = max(alpha, value)

            if alpha >= beta:
                break

        return value

    else:
        value = float('inf')

        for i in range(2):
            value = min(
                value,
                alphabeta(
                        depth + 1, 
                        index * 2 + i, 
                        True,
                        scores, 
                        target, 
                        alpha, 
                        beta
                )
            )

            beta = min( beta, value )

            if alpha >= beta:
                break

        return value

scores = [ 
        3, 5, 2, 9, 3, 5, 2, 9
    ]

depth = int(math.log2(len(scores)))

count = 0
result = minimax(0, 0, True, scores, depth)
print("Minimax Value:", result)
print("Minimax Counts:", count)

count = 0
result = alphabeta(
        0, 
        0, 
        True, 
        scores, 
        depth,
        float('-inf'), float('inf') 
    )

print("AlphaBeta Value:", result)
print("AlphaBeta Counts:", count)

